# Copy to .env.local to enable live generation (optional).
# If neither is set, Research and PRD agents run in deterministic mock mode.

# Preferred if both are set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used only if OPENAI_API_KEY is not set
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
